# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.

project_id = "netskope-gcp"
region     = "us-east1"
zones      = ["us-east1-b", "us-east1-c"]

name_prefix = "aigw-lab"

# Boot image: the default is the newest non-debug AI Gateway image in netskope-gcp.
# aig_image = "projects/netskope-gcp/global/images/ai-gateway-v1-9-63"

# Hostname used in the portal registration token and the self-signed certificate.
aig_hostname = "aig.aigw.internal"

# One OpenSSH public key line. Used for nsadmin and nsdebug.
ssh_public_key = "ssh-ed25519 AAAA...replace-me... you@your-host"

desired_capacity        = 1
max_capacity            = 4
cpu_scale_out_threshold = 70
